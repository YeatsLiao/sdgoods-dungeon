# sdkconfig.defaults —— sdgoods-dungeon 编译默认
# ESP-IDF v5.1+ · 目标芯片 ESP32-S3-R8

# ---- 芯片 / Flash ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- PSRAM (8MB Octal, R8 版本) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# ---- CPU / FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- 分区表 ----
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="platform/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="platform/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- LVGL ----
# 与 bsp 保持一致：LVGL 通用缓冲放 PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n

# ---- FAT 长文件名 ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_936=y    # 中文 GBK codepage

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- 编译器优化 ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y

# ---- 关闭不需要的子系统（独立固件不需要 WiFi/BLE）----
# 保留 BT/BLE 让 control_center 电量/配网可选；若明确不需要，可 disable 换 flash
# CONFIG_BT_ENABLED=n

# ---- 主内存分配 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Watchdog ----
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# LVGL 16bit byte order: align with platform baseline FACEENGINE (RGB panel wants high byte first; screenshot path assumes same)
CONFIG_LV_COLOR_16_SWAP=y
# v0.4：LVGL 内存改走标准 malloc（extmem threshold=0 自动落 PSRAM），
# 默认 32KB 静态池对背包网格+多层页面不够用
CONFIG_LV_MEM_CUSTOM=y
