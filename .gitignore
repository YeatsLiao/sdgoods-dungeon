resources/
!resources/.gitkeep
.cache/

# ---- 素材打包产物（assets.bin 已被 *.bin 兜住，此目录整体不入库）----
build_assets/

# ---- 编译期生成产物 ----
components/dungeon_engine/generated/
main/build_version.h

# ---- 打包产物 ----
dist/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 临时日志 / 抓包产物 ----
*.log
*.tmp
monitor_log.txt

# ---- 串口截屏产物 ----
shot_*.jpg
shot_*.png
shots/

# ---- 字体工具 ----
node_modules/
tools/fonts/*.ttf
tools/fonts/*.otf
tools/fonts/*.pbf
