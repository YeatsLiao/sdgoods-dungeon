# ---- ESP-IDF 构建产物 ----
build/
build_*/
*.bin
!platform/prebuilt/*.bin
*.elf
*.map
*.lst
flasher_args.json
flash_args
project_description.json
sdkconfig
sdkconfig.old
sdkconfig.ci
dependencies.lock

# ---- 组件管理器自动下载 ----
managed_components/

